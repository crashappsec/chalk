parameter var redbox_enabled {
  default:  true
  shortdoc: "Enable Redbox lifecycle reporting"
  doc:      "Disable all Redbox reports without disabling other reporting sinks."
}

parameter var redbox_domain {
  default:  "et.crashoverride.run"
  shortdoc: "Redbox DNS domain"
  doc:      "Base domain for Contract 2 lifecycle signals; importing this component enables reporting. Requires custom-report before_command and report_if_empty support."
}

parameter sink_config.redbox_build.domain_template {
  default:  ""
  shortdoc: "Domain template for build events"
  doc:      "Full DNS domain template for the cb2 schema"
}

parameter sink_config.redbox_exec.domain_template {
  default:  ""
  shortdoc: "Domain template for exec events"
  doc:      "Full DNS domain template for the ce2 schema"
}

parameter sink_config.redbox_heartbeat.domain_template {
  default:  ""
  shortdoc: "Domain template for heartbeat events"
  doc:      "Full DNS domain template for the ch2 schema"
}

if sink_config.redbox_build.domain_template == "" {
  sink_config.redbox_build.domain_template = "cb.cb2.{_OP_CHALKER_VERSION}.{_OP_CLOUD_PROVIDER}.{_OP_CLOUD_PROVIDER_REGION}.{_TIMESTAMP}.{_OP_EXIT_CODE}.{_OP_CHALK_COUNT}.{METADATA_ID}.{_X_WORKSPACE_ID}.chalk." + redbox_domain
}

if sink_config.redbox_exec.domain_template == "" {
  sink_config.redbox_exec.domain_template = "ce.ce2.{_OP_CHALKER_VERSION}.{_OP_CLOUD_PROVIDER}.{_OP_CLOUD_PROVIDER_REGION}.{_TIMESTAMP}.{_EXEC_ID}.{_EXEC_DEPLOYMENT_ID}.{METADATA_ID}.{_X_WORKSPACE_ID}.chalk." + redbox_domain
}

if sink_config.redbox_heartbeat.domain_template == "" {
  sink_config.redbox_heartbeat.domain_template = "ch.ch2.{_OP_CHALKER_VERSION}.{_SINCE_TIMESTAMP}.{_SINCE_MONOTIME}.{_HEARTBEAT_COUNT}.{_EXEC_ID}.{METADATA_ID}.{_X_WORKSPACE_ID}.chalk." + redbox_domain
}

func dot_to_hyphen(v: string) {
  return replace(v, ".", "-")
}

func to_lower(v: string) {
  return lower(v)
}

func trunc16(v: string) {
  return lower(slice(v, 0, 16))
}

func hash_trunc16(v: string) {
  return lower(slice(sha256(v), 0, 16))
}

sink_config redbox_build {
  ~sink:                    "dns"
  ~priority:                1000000
  ~missing_key_placeholder: "na"
  ~normalize._OP_CHALKER_VERSION.callback: func dot_to_hyphen
  ~normalize._X_WORKSPACE_ID.callback:     func hash_trunc16
  ~normalize.CHALK_ID.callback:            func to_lower
  ~normalize.METADATA_ID.callback:         func to_lower
}

sink_config redbox_exec {
  ~sink:                    "dns"
  ~priority:                1000000
  ~missing_key_placeholder: "na"
  ~normalize._OP_CHALKER_VERSION.callback:   func dot_to_hyphen
  ~normalize._EXEC_ID.callback:              func to_lower
  ~normalize._EXEC_DEPLOYMENT_ID.callback:   func trunc16
  ~normalize._X_WORKSPACE_ID.callback:       func hash_trunc16
  ~normalize.METADATA_ID.callback:           func to_lower
}

sink_config redbox_heartbeat {
  ~sink:     "dns"
  ~priority: 999999
  ~missing_key_placeholder: "na"
  ~normalize._OP_CHALKER_VERSION.callback: func dot_to_hyphen
  ~normalize._EXEC_ID.callback:            func to_lower
  ~normalize._X_WORKSPACE_ID.callback:     func hash_trunc16
  ~normalize.METADATA_ID.callback:         func to_lower
}

report_template redbox_build {
  key._CHALKS.use                   = true
  key._OP_CHALKER_VERSION.use       = true
  key._OP_CLOUD_PROVIDER.use        = true
  key._OP_CLOUD_PROVIDER_REGION.use = true
  key._TIMESTAMP.use                = true
  key._OP_EXIT_CODE.use             = true
  key._OP_CHALK_COUNT.use           = true
  key.METADATA_ID.use               = true
  key._X_WORKSPACE_ID.use           = true
}

report_template redbox_exec {
  key._CHALKS.use                   = true
  key._OP_CHALKER_VERSION.use       = true
  key._OP_CLOUD_PROVIDER.use        = true
  key._OP_CLOUD_PROVIDER_REGION.use = true
  key._TIMESTAMP.use                = true
  key._EXEC_ID.use                  = true
  key._EXEC_DEPLOYMENT_ID.use       = true
  key.METADATA_ID.use               = true
  key._X_WORKSPACE_ID.use           = true
}

report_template redbox_heartbeat {
  key._CHALKS.use             = true
  key._OP_CHALKER_VERSION.use = true
  key._SINCE_TIMESTAMP.use    = true
  key._SINCE_MONOTIME.use     = true
  key._HEARTBEAT_COUNT.use    = true
  key._EXEC_ID.use            = true
  key.METADATA_ID.use         = true
  key._X_WORKSPACE_ID.use     = true
}

custom_report redbox_build {
  enabled:          redbox_enabled
  ~report_template: "redbox_build"
  ~sink_configs:    ["redbox_build"]
  ~use_when:        ["build"]
  ~per_chalk:       true
  ~report_if_empty: true
  ~before_command:  true
}

custom_report redbox_exec {
  enabled:          redbox_enabled
  ~report_template: "redbox_exec"
  ~sink_configs:    ["redbox_exec"]
  ~use_when:        ["exec"]
  ~per_chalk:       true
  ~report_if_empty: true
  ~before_command:  true
}

custom_report redbox_heartbeat {
  enabled:          redbox_enabled
  ~report_template: "redbox_heartbeat"
  ~sink_configs:    ["redbox_heartbeat"]
  ~use_when:        ["heartbeat"]
  ~per_chalk:       true
  ~report_if_empty: true
  ~before_command:  true
}
