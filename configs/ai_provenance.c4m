# Records which AI coding agent, if any, was involved in producing an
# artifact. Three independent signals, all advisory:
#
#   build_agent=  the agent harness that invoked chalk, from the environment
#   trailer=      AI-authorship trailers on HEAD (repeatable)
#   identity=     HEAD author/committer matching a known agent identity
#
# Every mechanism here is user-suppressible (Claude Code's
# `attribution.commit`, Aider's `attribute_co_authored_by`, a `commit-msg`
# hook, `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1`). Presence is strong evidence of
# agent involvement; absence is no evidence either way. Do not gate policy on
# a missing value.
#
# Value is newline-separated `field=value`, following CODE_OWNERS' precedent of
# storing free-form authorship text rather than a nested type.

keyspec X_AI_AUTHORSHIP {
  kind:     ChalkTimeHost
  type:     string
  callback: func ai_authorship
  shortdoc: "AI coding agent involvement, if any"
  doc:      """
Newline-separated `field=value` records describing AI coding agent involvement
in this build:

- `build_agent=<name>` -- the agent harness that invoked chalk, detected from
  the environment. Detection order mirrors `gh`'s, so chalk and `gh` attribute
  a build to the same agent.
- `trailer=<line>` -- an AI-authorship trailer on HEAD (`Co-Authored-By:`,
  `Assisted-by:`, `Generated-by:`, `Claude-Session:`). Repeatable.
- `identity=<role> <name> <email>` -- HEAD author or committer matching a known
  agent identity. Catches tools such as Aider that rewrite the git identity
  instead of adding a trailer.

All three signals are advisory and user-suppressible. Presence is strong
evidence that an agent was involved; absence is no evidence either way. Do not
gate policy on a missing value.

Trailer and identity records require the `git` binary. Chalk otherwise reads git
through libgit2, so these are skipped rather than treated as a dependency; the
raw trailer text is always available in COMMIT_MESSAGE regardless.
"""
}

# Detection order mirrors gh's own agent detection so that chalk and `gh`
# attribute the same build to the same agent:
# https://github.com/cli/cli/blob/trunk/internal/agents/detect.go
#
# AI_AGENT is checked first and returned verbatim. It is a de facto convention
# originating from Vercel's detect-agent, not a ratified standard: it is
# undocumented by Anthropic, unset by Codex and Gemini CLI, and the competing
# proposal (agentsmd/agents.md#136) names the variable AGENT instead. Hence the
# per-vendor fallbacks below.
func ai_build_agent() {
  if env("AI_AGENT") != "" {
    return env("AI_AGENT")
  } elif env("AGENT") != "" {
    return env("AGENT")
  } elif env_exists("CODEX_SANDBOX") or env_exists("CODEX_CI") or env_exists("CODEX_THREAD_ID") {
    return "codex"
  } elif env_exists("GEMINI_CLI") {
    return "gemini-cli"
  } elif env_exists("COPILOT_CLI") {
    return "copilot-cli"
  } elif env_exists("OPENCODE") {
    return "opencode"
  } elif env_exists("ANTIGRAVITY_AGENT") {
    return "antigravity"
  } elif env_exists("AUGMENT_AGENT") {
    return "augment-cli"
  } elif env_exists("REPL_ID") {
    return "replit"
  } elif env_exists("CLAUDE_CODE_IS_COWORK") {
    return "claude-cowork"
  } elif env_exists("CLAUDECODE") or env_exists("CLAUDE_CODE") {
    return "claude-code"
  } elif env_exists("CURSOR_TRACE_ID") {
    return "cursor"
  } elif env_exists("CURSOR_AGENT") or env("CURSOR_EXTENSION_HOST_ROLE") == "agent-exec" {
    return "cursor-cli"
  } elif env_exists("GOOSE_PROVIDER") {
    return "goose"
  }
  return ""
}

# Trailer tokens: the vendor defaults (co-authored-by, claude-session) plus the
# forms mandated by project policy -- Fedora and the Linux kernel both require
# `Assisted-by:`, and the kernel forbids AI agents adding Signed-off-by at all.
# https://docs.kernel.org/process/coding-assistants.html
func ai_trailer_grep() {
  return "grep -iE '^(co-authored-by|assisted-by|generated-by|claude-session):'"
}

# Aider is the case a trailer-only check misses: `attribute_co_authored_by`
# defaults to false and it rewrites the git author/committer instead. Matched on
# vendor addresses plus aider's literal `aider (<model>)` name form, rather than
# on bare product names, which collide with human names (e.g. "Devin").
func ai_identity_grep() {
  return "grep -iE 'aider@aider\\.chat|noreply@anthropic\\.com|copilot@github\\.com|noreply@openai\\.com|aider \\('"
}

# Appends each non-empty line of `text` to `acc` as `field=<line>`.
func ai_append_lines(acc: string, field: string, text: string) {
  result := acc
  if text == "" {
    return
  }
  parts := split(text, "\n")
  for i from 0 to len(parts) {
    part := strip(parts[i])
    if part != "" {
      if result != "" {
        result := result + "\n"
      }
      result := result + field + "=" + part
    }
  }
}

func ai_authorship(contexts: string) {
  result := ""

  agent := ai_build_agent()
  if agent != "" {
    result := "build_agent=" + agent
  }

  # chalk reads git through libgit2 and does not otherwise need the git binary,
  # so trailer enrichment is best-effort and skipped when git is unavailable
  # rather than becoming a hard dependency. COMMIT_MESSAGE already carries the
  # raw trailer text for consumers that would rather parse it themselves.
  git_exe := find_exe("git", [])
  if git_exe == "" {
    return
  }

  dirs := split(contexts, ":")
  for i from 0 to len(dirs) {
    dir := dirs[i]
    if dir != "" and is_dir(dir) {
      base := git_exe + " -C '" + dir + "' log -1 "

      trailers := strip(run(base + "--format=%B 2>/dev/null | " +
                            ai_trailer_grep() + " || true"))
      result := ai_append_lines(result, "trailer", trailers)

      idents := strip(run(base +
                          "--format='author %an <%ae>%ncommitter %cn <%ce>' " +
                          "2>/dev/null | " + ai_identity_grep() + " || true"))
      result := ai_append_lines(result, "identity", idents)
    }
  }
}

# Subscribes X_AI_AUTHORSHIP so it is actually collected. A keyspec that no
# template references is never collected at all: registerKeys() walks only the
# `key.<NAME>` subsections that already exist, and hasSubscribedKey() then
# short-circuits the whole conffile plugin. The keyspec and these subscriptions
# are kept in one component on purpose -- loading the subscriptions without the
# keyspec is a hard validation error ("contains a key ... which does not
# exist"), so they must not be separable.
#
# Deliberately not subscribed:
#   reproducable  -- the value derives from the environment and from HEAD, so it
#                    is not reproducible across builds
#   minimal       -- bare-minimum marks only
#   chalk_labels  -- OCI label surface, kept small

mark_template mark_all {
  ~key.X_AI_AUTHORSHIP.use = true
}

mark_template mark_large {
  ~key.X_AI_AUTHORSHIP.use = true
}

mark_template mark_default {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template report_all {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template report_large {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template report_default {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template insertion_default {
  ~key.X_AI_AUTHORSHIP.use = true
}
