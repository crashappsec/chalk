# Records which AI coding agent, if any, was involved in producing an
# artifact. Three independent signals, all advisory:
#
#   build_agent=  the agent harness that invoked chalk, from the environment
#   trailer=      AI-authorship trailers on HEAD (repeatable)
#   identity=     HEAD author/committer matching a known agent identity
#
# Every mechanism here is user-suppressible (Claude Code's
# `attribution.commit`, Aider's `attribute_co_authored_by`, a `commit-msg`
# hook, `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1`). Presence is strong evidence of
# agent involvement; absence is no evidence either way. Do not gate policy on
# a missing value.
#
# Value is newline-separated `field=value`, following CODE_OWNERS' precedent of
# storing free-form authorship text rather than a nested type.

keyspec X_AI_AUTHORSHIP {
  kind:     ChalkTimeHost
  type:     string
  callback: func ai_authorship
  shortdoc: "AI coding agent involvement, if any"
  doc:      """
Newline-separated `field=value` records describing AI coding agent involvement
in this build:

- `build_agent=<name>` -- the agent harness that invoked chalk, detected from
  the environment. Detection order mirrors `gh`'s, so chalk and `gh` attribute
  a build to the same agent.
- `trailer=<line>` -- an AI-authorship trailer on HEAD. `Assisted-by:` and
  `Claude-Session:` are always recorded; `Co-Authored-By:` and `Generated-by:`
  only when they name a known agent identity, since both are also ordinary
  human/tooling metadata. The `Claude-Session:` value is an account-linked
  session URL and is replaced with `<<redact>>`. Repeatable.
- `identity=<role> <name> <email>` -- HEAD author or committer matching a known
  agent identity. Catches tools such as Aider that rewrite the git identity
  instead of adding a trailer.

All three signals are advisory and user-suppressible. Presence is strong
evidence that an agent was involved; absence is no evidence either way. Do not
gate policy on a missing value.

Trailer and identity records require the `git` binary. Chalk otherwise reads git
through libgit2, so these are skipped rather than treated as a dependency; the
raw trailer text is always available in COMMIT_MESSAGE regardless.
"""
}

# Detection order mirrors gh's own agent detection so that chalk and `gh`
# attribute the same build to the same agent:
# https://github.com/cli/cli/blob/trunk/internal/agents/detect.go
#
# AI_AGENT is a de facto convention originating from Vercel's detect-agent, not
# a ratified standard. Like gh, we accept it only when it is safe for
# attribution surfaces. AGENT is currently recognized only for Amp; other values
# are too broad to override the vendor-specific fallbacks below.
func ai_valid_agent_name(name: string) {
  if name == "" {
    return false
  }

  chars := to_chars(name)
  for i from 0 to len(chars) {
    ch := chars[i]
    if not ((ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or
            (ch >= '0' and ch <= '9') or ch == '-' or ch == '_') {
      return false
    }
  }
  return true
}

func ai_build_agent() {
  agent := env("AI_AGENT")
  if ai_valid_agent_name(agent) {
    return agent
  } elif env("AGENT") == "amp" {
    return "amp"
  } elif env_exists("CODEX_SANDBOX") or env_exists("CODEX_CI") or env_exists("CODEX_THREAD_ID") {
    return "codex"
  } elif env_exists("GEMINI_CLI") {
    return "gemini-cli"
  } elif env_exists("COPILOT_CLI") {
    return "copilot-cli"
  } elif env_exists("OPENCODE") {
    return "opencode"
  } elif env_exists("ANTIGRAVITY_AGENT") {
    return "antigravity"
  } elif env_exists("AUGMENT_AGENT") {
    return "augment-cli"
  } elif env_exists("REPL_ID") {
    return "replit"
  } elif env_exists("CLAUDE_CODE_IS_COWORK") {
    return "cowork"
  } elif env_exists("CLAUDECODE") or env_exists("CLAUDE_CODE") {
    return "claude-code"
  } elif env_exists("CURSOR_TRACE_ID") {
    return "cursor"
  } elif env_exists("CURSOR_AGENT") or env("CURSOR_EXTENSION_HOST_ROLE") == "agent-exec" {
    return "cursor-cli"
  } elif env("TERM_PROGRAM") == "kiro" {
    return "kiro"
  } elif contains(env("PATH"), "/.pi/agent") {
    return "pi"
  } elif env_exists("GOOSE_PROVIDER") {
    return "goose"
  }
  return ""
}

# Lower-cased substrings that identify an agent in a trailer value or a git
# identity. Vendor addresses only, plus Aider's literal `<name> (aider)`
# rewrite (aider/repo.py: `committer_name = f"{original_user_name} (aider)"`).
# Bare product names are deliberately excluded: "Claude" and "Devin" are human
# names too.
#
# Copilot's coding agent commits as `<id>+Copilot@users.noreply.github.com`,
# never `copilot@github.com`. Codex uses both `codex@` and `noreply@openai.com`.
func ai_identity_tokens() {
  return ["aider@aider.chat",
          "(aider)",
          "noreply@anthropic.com",
          "copilot@users.noreply.github.com",
          "codex@openai.com",
          "noreply@openai.com"]
}

func ai_is_agent_identity(line: string) {
  text   := lower(line)
  tokens := ai_identity_tokens()
  for i from 0 to len(tokens) {
    if contains(text, tokens[i]) {
      return true
    }
  }
  return false
}

# `Assisted-by:` is AI-specific by definition (Linux kernel and Fedora policy).
# `Claude-Session:` is only ever emitted by Claude Code. `Co-Authored-By:` and
# `Generated-by:` are shared with human co-authors and codegen tooling
# (`Generated-by: protoc-gen-go`), so they count only when the value names a
# known agent identity.
# https://docs.kernel.org/process/coding-assistants.html
func ai_is_agent_trailer(line: string) {
  text := lower(line)
  if starts_with(text, "assisted-by:") or starts_with(text, "claude-session:") {
    return true
  }
  if starts_with(text, "co-authored-by:") or starts_with(text, "generated-by:") {
    return ai_is_agent_identity(text)
  }
  return false
}

# The session URL is linked to the committer's claude.ai account and chalk
# marks ship inside public artifacts, so record presence only.
func ai_redact_trailer(line: string) {
  if starts_with(lower(line), "claude-session:") {
    return "Claude-Session: <<redact>>"
  }
  return line
}

func ai_append(acc: string, field: string, value: string) {
  result := acc
  if result != "" {
    result := result + "\n"
  }
  result := result + field + "=" + value
}

# One `git log` per context directory, matching libgit2's behaviour elsewhere in
# chalk: GIT_DIR and friends are unset because chalk opens the repository found
# from the directory, not from the environment, and `safe.directory=*` avoids
# the "dubious ownership" refusal when chalk runs as root over a bind-mounted
# workspace owned by another uid (libgit2 has no such check). Failures are
# silent by design: a non-repo, an unborn HEAD or a refused repo all yield an
# empty string.
func ai_git_head(git_exe: string, dir: string) {
  return run("unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_CEILING_DIRECTORIES; " +
             quote(git_exe) + " -c " + quote("safe.directory=*") +
             " -C " + quote(dir) + " log -1 --no-show-signature " +
             quote("--format=%H%nauthor %an <%ae>%ncommitter %cn <%ce>%n%B") +
             " 2>/dev/null")
}

func ai_authorship(contexts: string) {
  result := ""

  agent := ai_build_agent()
  if agent != "" {
    result := "build_agent=" + agent
  }

  # chalk reads git through libgit2 and does not otherwise need the git binary,
  # so trailer enrichment is best-effort and skipped when git is unavailable
  # rather than becoming a hard dependency. COMMIT_MESSAGE already carries the
  # raw trailer text for consumers that would rather parse it themselves.
  git_exe := find_exe("git", [])
  if git_exe == "" {
    return
  }

  # Several context directories usually resolve to one repository; record each
  # HEAD commit once.
  seen := []
  dirs := split(contexts, ":")
  for i from 0 to len(dirs) {
    dir := dirs[i]
    if dir == "" or not is_dir(dir) {
      continue
    }

    lines := split(ai_git_head(git_exe, dir), "\n")
    if len(lines) < 3 {
      continue
    }
    commit := strip(lines[0])
    if commit == "" or contains(seen, commit) {
      continue
    }
    seen := array_add(seen, [commit])

    for j from 3 to len(lines) {
      line := strip(lines[j])
      if ai_is_agent_trailer(line) {
        result := ai_append(result, "trailer", ai_redact_trailer(line))
      }
    }
    for j from 1 to 3 {
      line := strip(lines[j])
      if ai_is_agent_identity(line) {
        result := ai_append(result, "identity", line)
      }
    }
  }
}

# Subscribes X_AI_AUTHORSHIP so it is actually collected. A keyspec that no
# template references is never collected at all: registerKeys() walks only the
# `key.<NAME>` subsections that already exist, and hasSubscribedKey() then
# short-circuits the whole conffile plugin. The keyspec and these subscriptions
# are kept in one component on purpose -- loading the subscriptions without the
# keyspec is a hard validation error ("contains a key ... which does not
# exist"), so they must not be separable.
#
# Deliberately not subscribed:
#   reproducable  -- the value derives from the environment and from HEAD, so it
#                    is not reproducible across builds
#   minimal       -- bare-minimum marks only
#   chalk_labels  -- OCI label surface, kept small

mark_template mark_all {
  ~key.X_AI_AUTHORSHIP.use = true
}

mark_template mark_large {
  ~key.X_AI_AUTHORSHIP.use = true
}

mark_template mark_default {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template report_all {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template report_large {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template report_default {
  ~key.X_AI_AUTHORSHIP.use = true
}

report_template insertion_default {
  ~key.X_AI_AUTHORSHIP.use = true
}

# The built-in Crash Override template enumerates every key explicitly, so the
# key must be subscribed here or it never reaches a Crash Override report.
report_template crashoverride {
  ~key.X_AI_AUTHORSHIP.use = true
}
