policy {
  config_json: env("POLICY_CONFIG_JSON")
}

sink_config policy_file {
  enabled:  true
  sink:     "file"
  filename: env("POLICY_REPORT_FILE")
}

subscribe("policy", "policy_file")

tool.semgrep.semgrep_config_profile: env("SEMGREP_RULES")
tool.semgrep.semgrep_metrics:        "off"

if env_exists("RUN_SAST_TOOLS") {
  run_sast_tools: true
}
