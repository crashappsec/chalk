func deny_by_env(image: string, digest: string, stage: string, source: string) {
  if env_exists("POLICY_CUSTOM_DENY") and contains(image, env("POLICY_CUSTOM_DENY")) {
    return "denied by custom check"
  }
  return ""
}

policy {
  mode: env("POLICY_MODE")
  golden_images {
    enabled: true
    allowed: [("glob", "docker.io/library/alpine:*"), ("glob", "cgr.dev/chainguard/*")]
    message: "Use an approved golden image"
  }
  custom_check: func deny_by_env
}

sink_config policy_file {
  enabled:  true
  sink:     "file"
  filename: env("POLICY_REPORT_FILE")
}

subscribe("policy", "policy_file")

if env_exists("POLICY_ON_ERROR") {
  policy.on_error = env("POLICY_ON_ERROR")
}

if env_exists("POLICY_CERTIFICATES") {
  policy.certificates.enabled          = true
  policy.certificates.deny_self_signed = true
  policy.certificates.allowed_issuers  = [("cn", "Chalk Test Root CA")]
}

if env_exists("POLICY_NO_STEP_SUMMARY") {
  policy.github_step_summary = false
}

if env_exists("POLICY_PRESIGN_URL") {
  sink_config policy_presign {
    enabled: true
    sink:    "presign"
    uri:     env("POLICY_PRESIGN_URL")
  }
  subscribe("policy", "policy_presign")
}
